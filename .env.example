# Never commit `.env`. Production secrets come from Cerulean Vault (SecretOps).
# This repository has no server-side secrets: the app stores the server URL and a
# bearer token in the App Group, and the build credentials are repository secrets.

# The CourseMate server this build talks to by default.
COURSEMATE_SERVER_URL=http://127.0.0.1:8790

# Release credentials (GitHub secrets, never in the tree):
#   APP_STORE_CONNECT_KEY, APP_STORE_CONNECT_KEY_ID,
#   APP_STORE_CONNECT_ISSUER_ID, APPLE_TEAM_ID
#
# Push needs a separate APNs key — an App Store Connect key cannot sign a
# provider token. See docs/release.md.

# Identity is Cerulean Authentik (OIDC); DNS, TLS and the public proxy are Cerulean.
# Production secrets live in Cerulean Vault (KV v2) and are resolved from vault://<mount>/<path>#<KEY> refs.
