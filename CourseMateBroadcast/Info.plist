<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>CourseMate</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.broadcast-services-upload</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).SampleHandler</string>
		<key>RPBroadcastProcessMode</key>
		<string>RPBroadcastProcessModeSampleBuffer</string>
	</dict>
	<!-- The extension uploads on its own, so it needs the same transport rule as
	     the app: HTTPS to the hosted server, with a LAN exception for development.
	     Without this an http:// endpoint failed here with "requires the use of a
	     secure connection" while the app looked configured. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>CourseMate sends screen frames and lecture audio to the server on your network.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>CourseMate records lecture audio together with your screen so it can transcribe what was said.</string>
	<!-- The extension's own copy of the endpoint, so a broadcast works before
	     the app has ever written to the App Group. Values in the App Group (and
	     the control file) take precedence over these at runtime. -->
	<key>cm_url</key>
	<string>https://cm.innotel.us</string>
	<key>cm_token</key>
	<string></string>
	<!-- Fallback for a free Apple ID, where the App Group container cannot be
	     provisioned: set a server and session here, and rebuild the extension. -->
	<!--
	<key>cm_session</key>
	<string>ses_...</string>
	-->
</dict>
</plist>
